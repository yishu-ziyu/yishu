<plist version="1.0">
<dict>
	<key>LSUIElement</key>
	<true/>
	<key>VoiceTranscriptionProvider</key>
	<string>stepfun</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>奕枢需要麦克风，以便你按住快捷键说话。</string>
