{
  "name": "@yishu/runtime",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "exports": "./dist/index.js",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.check.json --noEmit",
    "dev": "tsx src/stdio-server.ts",
    "start": "node dist/stdio-server.js",
    "pretest": "pnpm --filter @yishu/kernel build",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@yishu/kernel": "workspace:*",
    "typebox": "1.3.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
