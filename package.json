{
  "name": "yishu",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "dep:check": "depcruise --config dependency-cruiser.config.cjs --output-type err packages",
    "size:check": "node script/check-file-size-limit.cjs",
    "product:check": "./script/verify-product.sh core",
    "product:verify": "./script/verify-product.sh full",
    "product:boundaries": "./script/check-product-boundaries.sh",
    "product:build:clicky": "./apps/clicky/scripts/run-local.sh build",
    "lab:verify": "pnpm --filter @yishu/agent-core check && pnpm --filter @yishu/agent-core test",
    "capability:eval": "node script/run-capability-eval.mjs",
    "capability:matrix": "node script/render-capability-matrix.mjs",
    "capability:gate": "node script/run-capability-eval.mjs --gate && node script/check-capability-tools.mjs",
    "generated:check": "node script/check-generated-files.mjs",
    "arch:check": "node script/check-architecture-ratchet.mjs",
    "audit:credentials": "node script/audit-credentials.mjs",
    "lab:agent:test": "pnpm --filter @yishu/agent-core test",
    "lab:agent:demo": "pnpm --filter @yishu/agent-core cli -- demo",
    "lab:agent:eval": "pnpm --filter @yishu/agent-core cli -- eval",
    "agent": "pnpm --filter @yishu/agent-core cli",
    "agent:test": "pnpm --filter @yishu/agent-core test",
    "agent:eval": "pnpm --filter @yishu/agent-core cli -- eval",
    "agent:demo": "pnpm --filter @yishu/agent-core cli -- demo",
    "agent:evolve": "pnpm --filter @yishu/agent-core cli -- evolve",
    "agent:judge": "pnpm --filter @yishu/agent-core cli -- judge-eval",
    "agent:mcp": "pnpm --filter @yishu/agent-core cli -- mcp-list",
    "agent:heartbeat": "pnpm --filter @yishu/agent-core cli -- heartbeat-demo",
    "agent:experience": "pnpm --filter @yishu/agent-core cli -- experience",
    "agent:status": "pnpm --filter @yishu/agent-core cli -- status",
    "kernel:test": "pnpm --filter @yishu/kernel test"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "brace-expansion": "5.0.9",
      "undici": "8.10.0"
    }
  },
  "devDependencies": {
    "dependency-cruiser": "^18.2.0"
  }
}
