.DS_Store
.build/
build/
dist/
node_modules/
packages/*/dist/
.yishu/
*.xcuserstate
xcuserdata/

# Dependencies & build (extra)
*.tsbuildinfo
.pnpm-store/

# Agent-core runtime data (regenerated by CLI/tests)
packages/agent-core/data/trajectories/
packages/agent-core/data/skill-drafts/
packages/agent-core/data/evolution/experience.jsonl
packages/agent-core/data/evolution/work/
packages/agent-core/data/evolution/snapshots/
packages/agent-core/data/memory.json
packages/agent-core/data/dynamic-tools.json
packages/agent-core/workspace/**
!packages/agent-core/workspace/.gitkeep

# Test temp dirs
packages/agent-core/test/.tmp*/
packages/agent-core/test/**/.tmp*/

# EverOS local venv (user-level install lives in ~/.yishu/everos-venv)
packages/runtime/.everos-venv/
.everos-venv/

# Local tooling
.codex/
.work/
.env
.env.*
!.env.example
*.log

# Formal Clicky shell: local secrets and generated Xcode/Node state
apps/clicky/**/xcuserdata/
apps/clicky/**/.codegraph/
apps/clicky/**/.dev.vars
apps/clicky/**/node_modules/
apps/clicky/**/.wrangler/
apps/clicky/**/DerivedData/
apps/clicky/**/*.xcuserstate
# Canonical Yishu Clicky build output (also used by run-local.sh)
.build/clicky-derived-data/
